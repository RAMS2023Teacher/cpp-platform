    "start": "node tools/build-gas.js && node tools/preview.js"
  },
  "devDependencies": {
    "meshoptimizer": "0.22.0",
    "occt-import-js": "0.0.23",
    "three": "0.147.0"
  },
  "engines": { "node": ">=18" }
}
